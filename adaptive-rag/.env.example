# Copy this file to `.env` and fill in the values you need.
# Never commit your real `.env` file — it's already in .gitignore.

# ---------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------
# Local dev with `docker-compose up -d` (see docker-compose.yml):
DATABASE_URL=postgresql://adaptive_rag:adaptive_rag@localhost:5432/adaptive_rag

# ---------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Main model used for answer generation (accuracy-sensitive).
CHAT_MODEL=gpt-4o-mini
# Cheaper/faster model used for classification & scoring nodes
# (query analysis, retrieval evaluation, reranking, verification).
FAST_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Must match the `vector(N)` dimension in database/migrations/001_init_schema.sql
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------
# LangSmith observability
# ---------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AdaptiveRAG
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------
# Optional external web search (Tavily), used only as a last-resort
# correction when local document evidence is insufficient
# ---------------------------------------------------------------------
ENABLE_WEB_SEARCH=false
WEB_SEARCH_API_KEY=

# ---------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------
# Generate a real random value for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value
SESSION_TTL_HOURS=168

# ---------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------
# Adaptive retrieval thresholds (section 19/21/23 of the spec)
# ---------------------------------------------------------------------
SUFFICIENT_THRESHOLD=0.75
PARTIAL_THRESHOLD=0.45
MAX_RETRIEVAL_ITERATIONS=3
MAX_VERIFICATION_RETRIES=1
DEFAULT_TOP_K=6
RERANK_TOP_N=5

# ---------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
